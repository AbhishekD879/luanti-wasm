FROM ubuntu:22.04

# install deps
RUN \
	   apt-get update \
	&& DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y \
		wget \
		python3 \
		git \
		build-essential \
		cmake \
		tclsh \
		zip \
		zstd \
		gettext \
		xz-utils \
		ca-certificates

# install_emsdk.sh opens with `which node` and then refuses anything that is not
# v24.x — it points emsdk's .emscripten at the SYSTEM node rather than the one
# emsdk bundles. Ubuntu 22.04's apt nodejs is v12, and this Dockerfile installed
# no node at all, so the image died immediately with an empty NODE_FULL_PATH.
# Fetch an official v24 build.
ARG NODE_VERSION=24.21.0
RUN set -eux; \
	arch="$(dpkg --print-architecture)"; \
	case "$arch" in \
		amd64) narch=x64 ;; \
		arm64) narch=arm64 ;; \
		*) echo "unsupported arch: $arch" >&2; exit 1 ;; \
	esac; \
	wget -q "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${narch}.tar.xz" -O /tmp/node.tar.xz; \
	tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
	rm /tmp/node.tar.xz; \
	node --version

COPY . /luanti-wasm

RUN cd /luanti-wasm && ./install_emsdk.sh
